# Nukopijuokite į .env ir pakeiskite reikšmes (NFR-38). .env failas į Git nekeliamas (NFR-57).

# Duomenų bazė
DB_NAME=mealplanner
DB_USER=mealplanner
DB_PASSWORD=pakeiskite-slaptazodi

# Sesijos slapukas su Secure savybe siunčiamas tik per HTTPS.
# Lokaliai (http://localhost) – false, serveryje su HTTPS – true (NFR-14).
COOKIE_SECURE=false

# Žiniatinklio serverio prievadas kompiuteryje
HTTP_PORT=80

# DI komponentas: Google Gemini API raktas (https://aistudio.google.com/apikey).
# Be rakto sistema veikia, tik plano generavimas baigiasi klaidos pranešimu (NFR-29).
GEMINI_API_KEY=
# DI modelis (DIA-4). Gemini 3 modeliams mąstymo lygis: MINIMAL, LOW, MEDIUM, HIGH
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=MINIMAL
