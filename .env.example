# Nukopijuokite į .env ir pakeiskite reikšmes (NFR-38). .env failas į Git nekeliamas (NFR-57).

# Duomenų bazė
DB_NAME=mealplanner
DB_USER=mealplanner
DB_PASSWORD=pakeiskite-slaptazodi

# Sesijos slapukas su Secure savybe siunčiamas tik per HTTPS.
# Lokaliai (http://localhost) – false, serveryje su HTTPS – true (NFR-14).
COOKIE_SECURE=false

# Žiniatinklio serverio prievadas kompiuteryje
HTTP_PORT=80

# 2 sprintas: Google Gemini API raktas DI komponentui
# GEMINI_API_KEY=
